# NeutralNews runtime configuration

# API bind address. Keep loopback by default for local use.
API_HOST=127.0.0.1

# API port. API_PORT takes priority over PORT when both are present.
API_PORT=3000
PORT=

# Vite development server port.
WEB_PORT=5173

# IANA time zone used by backend date calculations.
NEUTRALNEWS_TIME_ZONE=America/Argentina/Buenos_Aires

# Local runtime data directory. F0.6 will create/use this directory for JSON storage.
NEUTRALNEWS_DATA_DIR=.neutralnews-data

# External service timeout in milliseconds for RSS, article extraction and provider calls.
NEUTRALNEWS_EXTERNAL_TIMEOUT_MS=15000

# Maximum attempts for transient, idempotent external operations.
NEUTRALNEWS_EXTERNAL_MAX_ATTEMPTS=3

# Delay in milliseconds between retry attempts.
NEUTRALNEWS_EXTERNAL_RETRY_DELAY_MS=250

# Maximum number of RSS feeds read in parallel.
NEUTRALNEWS_RSS_MAX_CONCURRENCY=3

# Optional comma-separated IPs of explicitly trusted TLS-terminating proxies.
NEUTRALNEWS_TRUSTED_PROXY_ADDRESSES=

# Comma-separated exact HTTP(S) origins allowed to perform authenticated mutations.
# Defaults to local API and Vite origins when API_HOST is 127.0.0.1 or localhost.
NEUTRALNEWS_ALLOWED_ORIGINS=

# Internal access password hash. Use an Argon2id PHC hash, never a plain password.
NEUTRALNEWS_ACCESS_PASSWORD_HASH=

# Internal session signing secret. Use a random value with at least 32 characters.
NEUTRALNEWS_SESSION_SECRET=

# Optional local credential vault key. Use a random 32-byte base64url value.
NEUTRALNEWS_CREDENTIAL_VAULT_KEY=
