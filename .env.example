# NeutralNews runtime configuration

# API bind address. Keep loopback by default for local use.
API_HOST=127.0.0.1

# API port. API_PORT takes priority over PORT when both are present.
API_PORT=3000
PORT=

# Vite development server port.
WEB_PORT=5173

# IANA time zone used by backend date calculations.
NEUTRALNEWS_TIME_ZONE=America/Argentina/Buenos_Aires

# Local runtime data directory. F0.6 will create/use this directory for JSON storage.
NEUTRALNEWS_DATA_DIR=.neutralnews-data

# Internal access password hash. Use a bcrypt or Argon2 hash, never a plain password.
NEUTRALNEWS_ACCESS_PASSWORD_HASH=

# Internal session signing secret. Use a random value with at least 32 characters.
NEUTRALNEWS_SESSION_SECRET=
